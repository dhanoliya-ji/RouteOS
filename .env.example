# ---- RouteOS environment configuration ----
# Copy to .env and adjust as needed:  cp .env.example .env

# --- Postgres / PostGIS ---
POSTGRES_USER=routeos
POSTGRES_PASSWORD=routeos_dev_password
POSTGRES_DB=routeos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full SQLAlchemy async URL (built from the parts above inside docker-compose)
DATABASE_URL=postgresql+asyncpg://routeos:routeos_dev_password@postgres:5432/routeos
# Sync URL used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg://routeos:routeos_dev_password@postgres:5432/routeos

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
# Generate a strong secret for production:  openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Optional regex of additional allowed origins. Used when deploying to a managed
# host where the frontend's exact URL isn't known until after it is created
# (see render.yaml). Leave empty locally.
BACKEND_CORS_ORIGIN_REGEX=

# --- Optimization / routing ---
# OSRM public server (optional). If unreachable, RouteOS falls back to
# Haversine distance * ROAD_DISTANCE_FACTOR automatically.
OSRM_BASE_URL=https://router.project-osrm.org
USE_OSRM=false
ROAD_DISTANCE_FACTOR=1.25
# Average urban speed used to convert distance -> travel time (km/h)
AVERAGE_SPEED_KMH=30
# OR-Tools solver wall-time limit per optimization run (seconds)
SOLVER_TIME_LIMIT_SECONDS=15
# OR-Tools first-solution heuristic. This dominates the final answer whenever the
# local search gets few iterations (slow or shared CPUs). Alternatives:
# PARALLEL_CHEAPEST_INSERTION, SAVINGS, CHRISTOFIDES, AUTOMATIC.
SOLVER_FIRST_SOLUTION_STRATEGY=PATH_CHEAPEST_ARC

# --- Frontend (Vite build-time) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# --- Seed / demo accounts ---
DEMO_ADMIN_EMAIL=admin@routeos.dev
DEMO_ADMIN_PASSWORD=admin12345
DEMO_DISPATCHER_EMAIL=dispatcher@routeos.dev
DEMO_DISPATCHER_PASSWORD=dispatch12345
DEMO_VIEWER_EMAIL=viewer@routeos.dev
DEMO_VIEWER_PASSWORD=viewer12345

# Host-side published ports (override if a local Postgres/Redis already uses the defaults)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
